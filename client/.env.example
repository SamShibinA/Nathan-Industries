# ===================================================================
# NathanIndustries Frontend Environment Variables (Vercel & Local)
# ===================================================================

# For Local Development:
# VITE_API_URL=http://localhost:5000/api

# For Vercel Production Deployment:
# Point this to your deployed Vercel Backend URL (with or without /api)
# Example: https://nathan-industries-backend.vercel.app/api
VITE_API_URL=https://<your-backend-deployment>.vercel.app/api
