# ===================================================================
# NathanIndustries Backend Environment Variables (Vercel & Local)
# ===================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI (Use MongoDB Atlas for Vercel deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nathan_industries?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nathan_industries?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a random 64-character secret)
JWT_SECRET=generate_a_secure_jwt_secret_key_here

# Frontend Client URL(s) - Comma-separated if multiple
# Example: https://nathan-industries.vercel.app,http://localhost:5173
CLIENT_URL=https://<your-frontend-deployment>.vercel.app

# Cloudinary Storage Credentials (for persistent image & document uploads)
CLOUDINARY_CLOUD_NAME=fpbcpccp
CLOUDINARY_API_KEY=555652249841283
CLOUDINARY_API_SECRET=hQdIDneTDYfzFe15I70bqduwtR4

# Static upload path (legacy fallback)
UPLOAD_PATH=uploads
